{
  "name": "@statewalker/shared-commands",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "description": "Typed command bus and reactive registry. Declare commands via `Command.required(key).input(s).output(s).build()`; dispatch via `commands.call(decl, payload)`; register listeners via `commands.listen(decl, fn, { priority? })`; compose declarations via `CommandsRegistry.create/.compose/.filter/.namespace`.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-shared/issues"
  },
  "keywords": [
    "command",
    "command-pattern",
    "rpc",
    "late-binding",
    "fragment",
    "extension-point"
  ],
  "homepage": "https://github.com/statewalker/statewalker-shared/tree/main/packages/shared-commands#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-shared.git",
    "directory": "packages/shared-commands"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@standard-community/standard-json": "catalog:",
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
